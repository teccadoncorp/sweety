# Sweety — copy to .env before `docker compose up`

POSTGRES_USER=sweety
POSTGRES_PASSWORD=sweety
POSTGRES_DB=sweety
DATABASE_URL=postgresql://sweety:sweety@db:5432/sweety
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=10080

OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
SWEETY_CHAT_MODEL=openai/gpt-4o-mini
SWEETY_SEARCH_MODEL=openai/gpt-4o-mini
SWEETY_IMAGE_MODEL=google/gemini-2.5-flash-image

# Users hit this origin in the browser (local or the public EC2 host).
SWEETY_PUBLIC_URL=http://34.255.116.239
SWEETY_API_PUBLIC_URL=http://34.255.116.239
# Browser never calls the API. Next.js proxies /api and /media server-side.
# Docker Compose sets this to http://api:8000 on the web service.
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=
# Extra CORS origins, comma-separated (production host is also taken from SWEETY_PUBLIC_URL)
CORS_ORIGINS=
SEED_DEMO=true
SEED_EMAIL=board@sweety.local
SEED_PASSWORD=sweety
# Optional defaults for `docker compose --profile tools run --rm create-admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=
REQUIRE_PUBLISH_APPROVAL=true

# Social OAuth apps — callback is {SWEETY_API_PUBLIC_URL}/api/v1/connectors/callback/{provider}
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Optional connectors (or paste per-brand in Settings)
HEYGEN_API_KEY=
HEYGEN_DEFAULT_AVATAR_ID=
HEYGEN_DEFAULT_VOICE_ID=
TAVILY_API_KEY=
BRAVE_API_KEY=
